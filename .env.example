# Copy this file to .env and fill in your API keys.
# Never commit .env — it is gitignored.

# Groq — primary AI chat (streaming, fast)
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace — Qwen/Llama for insights & reports
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Mistral — fallback when Groq is rate-limited
# Get from: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily — web search for competitor news feed
# Get from: https://app.tavily.com → API Keys
TAVILY_API_KEY=your_tavily_api_key_here

# Login credentials — single user (change these before deploying)
FD_USERNAME=admin
FD_PASSWORD=FinBoard2025

# JWT signing secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=fd-dev-secret-change-in-production

# Docker only — directory containing seed Excel files inside the container.
# Set to /seed when using docker-compose (files are mounted there).
# Leave unset for local (non-Docker) development — auto-detected.
# SEED_DIR=/seed
